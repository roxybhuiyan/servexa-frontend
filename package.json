{
  "name": "servexa-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --port 3000",
    "audit:coverage": "node scripts/audit.mjs",
    "format": "prettier --write src tests scripts *.ts *.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "7.18.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
